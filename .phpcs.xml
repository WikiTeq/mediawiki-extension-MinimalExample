<?xml version="1.0"?>
<ruleset>
	<rule ref="./vendor/mediawiki/mediawiki-codesniffer/MediaWiki">
		<!--
			Until version 41.0.0 of mediawiki/mediawiki-codesniffer typed
			properties still needed documentation blocks for this sniff to
			accept them, but we use fully typed properties here so its just
			annoying.
		-->
		<exclude name="MediaWiki.Commenting.PropertyDocumentation.MissingDocumentationPrivate" />
		<!--
			phpcsutils < 1.2.3 runs eval() on array keys in these two sniffs
			(GHSA-r6hr-vr92-vv28). They are not enabled by the MediaWiki standard;
			the excludes keep them off. See the audit ignore in composer.json.
		-->
		<exclude name="Universal.Arrays.DuplicateArrayKey" />
		<exclude name="Universal.Arrays.MixedArrayKeyTypes" />
	</rule>
	<rule ref="MediaWiki.Commenting.ClassLevelLicense">
		<properties>
			<property name="license" value="MIT" />
		</properties>
	</rule>
	<file>.</file>
	<arg name="extensions" value="php"/>
	<arg name="encoding" value="UTF-8"/>
</ruleset>
