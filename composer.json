	"require": {
		"league/commonmark": "^2.9.0"
	},
	"require-dev": {
		"mediawiki/mediawiki-codesniffer": "51.0.1 || 45.0.0 || 38.0.0",
		"mediawiki/mediawiki-phan-config": "0.12.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"test": [
			"@phpcs"
		],
		"phan": "phan -d . --long-progress-bar",
